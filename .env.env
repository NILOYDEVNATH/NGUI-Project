# Supabase Configuration
# Get these from: Supabase Dashboard → Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optional server-side key for Raspberry Pi backend reads when RLS blocks anon selects.
SUPABASE_SERVICE_ROLE_KEY=

# Edge Function Configuration
# Leave URLs blank to use: SUPABASE_URL/functions/v1/<function-name>
EDGE_FUNCTION_API_KEY=
ROUTE_API_URL=
SYNC_GOOGLE_CALENDAR_URL=
SYNC_CALENDAR_ON_USER_SELECT=false

# Display Configuration
# Options: 'monitor', 'kiosk', 'led', or 'both'
DISPLAY_TYPE=kiosk

# Web Server Port (for monitor display)
DISPLAY_PORT=8080

# Update frequency (milliseconds)
TEXT_REFRESH_RATE=100

# LED Matrix Configuration (if using LED)
LED_ROWS=32
LED_COLS=64
LED_BRIGHTNESS=100
LED_GPIO_SLOWDOWN=2

# Logging
LOG_LEVEL=info
LOG_FILE=logs/display.log
